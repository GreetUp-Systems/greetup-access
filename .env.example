# ─────────────────────────────────────────────────────────────────────────────
# Access — Environment Variables
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env com valores reais
#
# Arquitetura vigente: docs/06-sdd/MVP-REVISADO.md
# ─────────────────────────────────────────────────────────────────────────────

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# ─── Banco de Dados ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://access:access@localhost:5432/access_dev
DATABASE_URL_DIRECT=postgresql://access:access@localhost:5432/access_dev

# ─── Redis (apenas BullMQ — sem cache, ver D-16) ──────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-string-in-production
JWT_EXPIRES_IN=7d

# ─── Privy — provedor de wallets (D-01) ───────────────────────────────────────
PRIVY_APP_ID=
PRIVY_APP_SECRET=
NEXT_PUBLIC_PRIVY_APP_ID=

# ─── BlindPay — provedor de pagamentos (D-08) ─────────────────────────────────
BLINDPAY_API_KEY=
BLINDPAY_INSTANCE_ID=
BLINDPAY_BASE_URL=https://api.blindpay.com
BLINDPAY_WEBHOOK_SECRET=
# Configuração de taxa do Access (D-13) — criada via POST /partner-fees
BLINDPAY_PARTNER_FEE_ID=

# ─── Stellar ──────────────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Mainnet: https://horizon.stellar.org · Public Global Stellar Network ; September 2015

STELLAR_USDC_ASSET_CODE=USDC
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Mainnet USDC issuer: GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
# Em instância de desenvolvimento a BlindPay usa USDB, não USDC

# ─── Contrato do ingresso (D-03) ──────────────────────────────────────────────
SOROBAN_TICKET_CONTRACT_ADDRESS=C...

# ─── OpenZeppelin Relayer — gas patrocinado (D-02) ────────────────────────────
OZ_RELAYER_URL=https://channels.openzeppelin.com/testnet
OZ_RELAYER_API_KEY=
# Produção: self-host via Docker

# ─── Conta patrocinadora de reservas (D-02) ───────────────────────────────────
# O Relayer paga a TAXA das transações, mas a reserva mínima da conta Stellar
# (~1 XLM) e da trustline (~0,5 XLM) exige que esta conta assine a operação
# beginSponsoringFutureReserves. Precisa de saldo em XLM.
STELLAR_SPONSOR_ADDRESS=G...
# NUNCA colocar a chave privada aqui em produção — usar gestor de secrets.
# Desenvolvimento local apenas:
STELLAR_SPONSOR_SECRET=S...

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=noreply@greetup.com

# ─── Erros ────────────────────────────────────────────────────────────────────
SENTRY_DSN=
# Observabilidade completa (OTel, Grafana, Prometheus) está fora de escopo — D-18

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX_PAYMENT=5
RATE_LIMIT_MAX_CHECKIN=120
RATE_LIMIT_MAX_DEFAULT=300

# ─── Feature Flags ────────────────────────────────────────────────────────────
DISABLE_NEW_PAYMENTS=false

# ─── BullMQ — três workers (D-15) ─────────────────────────────────────────────
BULLMQ_CONCURRENCY_MINT=5
BULLMQ_CONCURRENCY_NOTIFY=20
BULLMQ_MAX_ATTEMPTS=5
BULLMQ_BACKOFF_DELAY=1000

# ─── Outbox Relay (D-14) ──────────────────────────────────────────────────────
OUTBOX_POLLING_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
