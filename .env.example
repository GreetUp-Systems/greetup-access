# Access — Foundation v2
# Execute `pnpm env:init` para criar .env sem sobrescrever um arquivo existente.
# Nunca commite valores reais ou secrets.

NODE_ENV=development
API_PORT=3001

# API/runtime: login restrito, sem ownership e sem BYPASSRLS.
DATABASE_URL=postgresql://access_runtime:access_runtime@localhost:5432/access_dev
# Migrations/CLI: owner do schema; nunca usar para atender requests.
DATABASE_URL_DIRECT=postgresql://access:access@localhost:5432/access_dev
# Webhook BlindPay verificado: acesso técnico apenas às tabelas necessárias.
# Em development, deixe esta URL e BLINDPAY_WEBHOOK_SECRET ambos vazios para desativá-lo.
# Exemplo ao ativar: postgresql://access_blindpay_webhook_login:access_blindpay_webhook@localhost:5432/access_dev
DATABASE_URL_BLINDPAY_WEBHOOK=

REDIS_URL=redis://localhost:6379
HEALTH_CHECK_TIMEOUT_MS=2000

PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_JWT_VERIFICATION_KEY=
PRIVY_API_TIMEOUT_MS=5000

BLINDPAY_API_KEY=
BLINDPAY_INSTANCE_ID=
BLINDPAY_BASE_URL=https://api.blindpay.com/v1
# Ative junto com DATABASE_URL_BLINDPAY_WEBHOOK quando houver endpoint HTTPS público.
BLINDPAY_WEBHOOK_SECRET=
BLINDPAY_API_TIMEOUT_MS=5000
BLINDPAY_ALLOWED_REDIRECT_ORIGINS=http://localhost:3000
