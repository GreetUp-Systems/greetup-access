# Access — Foundation v2
# Execute `pnpm env:init` para criar .env sem sobrescrever um arquivo existente.
# Nunca commite valores reais ou secrets.

NODE_ENV=development
API_PORT=3001

# API/runtime: login restrito, sem ownership e sem BYPASSRLS.
DATABASE_URL=postgresql://access_runtime:access_runtime@localhost:5432/access_dev
# Migrations/CLI: owner do schema; nunca usar para atender requests.
DATABASE_URL_DIRECT=postgresql://access:access@localhost:5432/access_dev
# Webhook BlindPay verificado: acesso técnico apenas às tabelas necessárias.
# Em development, deixe esta URL e BLINDPAY_WEBHOOK_SECRET ambos vazios para desativá-lo.
# Exemplo ao ativar: postgresql://access_blindpay_webhook_login:access_blindpay_webhook@localhost:5432/access_dev
DATABASE_URL_BLINDPAY_WEBHOOK=
# Workers (OutboxRelay, MintTicketWorker, NotifyWorker) use the restricted access_worker role.
DATABASE_URL_WORKER=postgresql://access_worker_login:access_worker@localhost:5432/access_dev

REDIS_URL=redis://localhost:6379
HEALTH_CHECK_TIMEOUT_MS=2000

PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_JWT_VERIFICATION_KEY=
PRIVY_API_TIMEOUT_MS=5000

BLINDPAY_API_KEY=
BLINDPAY_INSTANCE_ID=
BLINDPAY_BASE_URL=https://api.blindpay.com/v1
# Ative junto com DATABASE_URL_BLINDPAY_WEBHOOK quando houver endpoint HTTPS público.
BLINDPAY_WEBHOOK_SECRET=
BLINDPAY_API_TIMEOUT_MS=5000
BLINDPAY_ALLOWED_REDIRECT_ORIGINS=http://localhost:3000
# Partner fee (pf_...) of the Access fee on payins; empty disables it (D-13).
BLINDPAY_PARTNER_FEE_ID=

# Stellar Gate 3C — development/testnet only. Never commit the sponsor secret.
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Read by the Stellar CLI, which loads this .env: with STELLAR_RPC_URL set it requires the passphrase.
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_ASSET_CODE=USDB
STELLAR_ASSET_ISSUER=GCQSSIMOW5OCGULZATDXKU5MOJBOMFX6G65X6CXZDQ7AIB3SKFUZ67NX
# USDC de teste da Circle na Testnet; a trustline é criada junto com a de USDB.
STELLAR_USDC_ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
STELLAR_SPONSOR_PUBLIC_KEY=
STELLAR_SPONSOR_SECRET_KEY=
# TicketContract on Testnet, as recorded in packages/contracts/caatinga.artifacts.json (D-25).
STELLAR_TICKET_CONTRACT_ID=CBCO3MQGVHKJ5WRAEGWYI3E3TF4T6L5PNCXSK4MPGVDITIRNRZDPODNT

# Assina o QR Code dos ingressos (SPEC-008): 32 bytes aleatórios em base64url. Trocar invalida todos.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TICKET_QR_SECRET=

# NotifyWorker (SPEC-008): e-mail "seus ingressos estão prontos" pelo Resend. As três juntas ou
# nenhuma: vazias desligam o envio em development, e os ticket.issued esperam no Outbox.
# Obrigatórias em production. Sem domínio verificado, o Resend só entrega à conta dona da key.
RESEND_API_KEY=
EMAIL_FROM=
# Base do link do e-mail (área do comprador em /me/tickets).
APP_PUBLIC_URL=
