{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "!**/*.test.ts", "!**/*.spec.ts"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "jest.config.*", "../../jest.preset.cjs"],
      "outputs": []
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "lint": {
      "inputs": ["src/**", "test/**", "*.ts", "../../eslint.config.mjs"],
      "outputs": []
    },
    "format": {
      "inputs": ["src/**", "*.ts"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig*.json"],
      "outputs": []
    },
    "db:generate": {
      "cache": false,
      "inputs": ["prisma/schema.prisma"]
    },
    "db:migrate": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  },
  "globalDependencies": [
    ".env",
    "tsconfig.json"
  ],
  "globalEnv": [
    "NODE_ENV",
    "API_PORT",
    "DATABASE_URL",
    "DATABASE_URL_DIRECT",
    "REDIS_URL",
    "HEALTH_CHECK_TIMEOUT_MS"
  ]
}
