{
  "name": "@access/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Access design system: Tailwind theme generated from Figma and shadcn/ui components adapted to it",
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./assets/*": "./src/assets/*"
  },
  "scripts": {
    "tokens": "tsx tokens/build-tokens.ts",
    "lint": "tsx tokens/build-tokens.ts --check && eslint \"src/**/*.{ts,tsx}\" \"tokens/**/*.ts\" --max-warnings=0 && stylelint \"src/**/*.css\"",
    "test": "jest --config jest.config.ts --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "react": "^19"
  }
}
