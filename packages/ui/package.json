{
  "name": "@access/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Access design system: tokens generated from Figma and React components that mirror it",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css"
  },
  "scripts": {
    "tokens": "tsx tokens/build-tokens.ts",
    "lint": "tsx tokens/build-tokens.ts --check && eslint \"src/**/*.{ts,tsx}\" \"tokens/**/*.ts\" --max-warnings=0 && stylelint \"src/**/*.css\"",
    "test": "jest --config jest.config.ts --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.52.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "react": "^19"
  },
  "peerDependencies": {
    "react": "^19"
  }
}
