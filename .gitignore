# ─── Secrets — nunca commitar ────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
*.pem
*.key
*.p12
*.pfx

# ─── Node ─────────────────────────────────────────────────────────────────────
node_modules/
dist/
build/
.cache/
*.tsbuildinfo

# ─── Turbo ────────────────────────────────────────────────────────────────────
.turbo/

# ─── Next.js ──────────────────────────────────────────────────────────────────
.next/
out/

# ─── NestJS ───────────────────────────────────────────────────────────────────
dist/

# ─── Rust / Soroban ───────────────────────────────────────────────────────────
target/
*.wasm
Cargo.lock
# Contract builds are reproducible only with the lockfile (SPEC-006).
!packages/contracts/Cargo.lock
# Regenerated by soroban-sdk testutils on every test run.
test_snapshots/

# ─── Prisma ───────────────────────────────────────────────────────────────────
# Manter migrations versionadas — não ignorar

# ─── Testes ───────────────────────────────────────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/

# ─── Railway ──────────────────────────────────────────────────────────────────
.railway/

# ─── Docker ───────────────────────────────────────────────────────────────────
# Não ignorar Dockerfile e docker-compose.yml — eles são versionados

# ─── IDEs ─────────────────────────────────────────────────────────────────────
.idea/
.vscode/settings.json
.vscode/launch.json
*.swp
*.swo
.vim/

# Manter compartilhado da equipe
!.vscode/extensions.json
!.vscode/tasks.json

# Adaptadores locais gerados por ferramentas de agentes
